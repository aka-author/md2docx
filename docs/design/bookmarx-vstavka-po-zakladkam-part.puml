@startuml bookmarx-vstavka-po-zakladkam-part
title Скрипт bookmarx.vbs. Алгоритм этапа html2docx

skinparam activity {
  BackgroundColor #FEFECE
  BorderColor #A80036
  FontName Arial
}
skinparam note {
  BackgroundColor #FFFFCC
  BorderColor #999999
}

start

:Открыть журнал;
:Разобрать аргументы\n(HTML, шаблон DOCX, выходной DOCX, журнал);

if (HTML и шаблон существуют?) then (нет)
  :Записать ошибку в журнал;
  stop
else (да)
endif

:Создать экземпляр Word (невидимый);
:Скопировать шаблон и HTML во временный каталог;
:Открыть копию шаблона для записи;
:Открыть копию HTML только для чтения;

:Установить Bookmarks.ShowHidden = True\nв шаблоне и в HTML;

:Запомнить имена закладок зон шаблона part_*;

partition "Замена зон part_" {
  :Собрать закладки part_* шаблона,\nотсортировать по убыванию позиции;

  while (Есть необработанная зона part_<подпись>?) is (да)
    :Найти в HTML открывающую закладку part_<хвост>\nс текстом, равным <подпись>;
    if (Пара part_<хвост> / _part_<хвост> найдена\nи фрагмент не пуст?) then (да)
      if (Зона заканчивается ¶,\nфрагмент — нет?) then (да)
        :Исключить концевой ¶ зоны из замены;
      else (нет)
      endif
      :Присвоить FormattedText зоны\nзначению FormattedText фрагмента;
      if (Ошибка Word?) then (да)
        :Записать в журнал, пропустить зону;
      else (нет)
      endif
    else (нет)
      :Записать предупреждение, пропустить зону;
    endif
  endwhile (нет)
}

:Закрыть HTML без сохранения;

partition "Назначение стилей style_" {
  :Собрать имена открывающих закладок style_*\nосновного текста;

  while (Есть необработанная style_<хвост>?) is (да)
    :Прочитать имя стиля из текста\nоткрывающей закладки якоря;
    if (Есть пара style_<хвост> / _style_<хвост>\nи стиль в документе?) then (да)
      :Назначить стиль абзацам диапазона пары,\nкроме абзацев целиком внутри\nоткрывающей или закрывающей закладки;
      note right
        Символьный стиль — диапазону
        между концом открывающей
        и началом закрывающей закладки
      end note
    else (нет)
      :Записать предупреждение, пропустить;
    endif
  endwhile (нет)
}

partition "Удаление подписей якорей HTML" {
  :Собрать закладки якорей HTML\n(part_<хвост>, style_<хвост>, закрывающие _…),\nкроме закладок зон шаблона part_*;

  while (Есть закладка для очистки?) is (да)
    :Удалить весь диапазон Bookmark.Range\n(порядок: убывание позиции);
    if (Абзац пустой?) then (да)
      :Удалить абзац;
    else (нет)
    endif
  endwhile (нет)
}

:Сохранить выходной DOCX (SaveAs2);
:Закрыть шаблон;
:Завершить Word;
:Удалить временные копии;
:Закрыть журнал;

stop

@enduml
